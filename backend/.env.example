DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/link?charset=utf8mb4
JWT_SECRET_KEY=link-demo-change-me
SEED_ON_STARTUP=true

# DeepSeek API（只在后端配置，不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=60

# RAG 知识库（backend/rag，接口前缀 /api/rag）
# 本机默认启用；PUBLIC_DEPLOYMENT=true 时必须显式设为 true 才开放
# RAG_ENABLED=true
# 公网部署必须填写管理员账号（逗号分隔），否则无人可上传/删除资料；本机留空时 teacher 角色可管理
# RAG_ADMIN_ACCOUNTS=
# RAG_STORAGE_DIR=instance/rag
# local = 离线哈希向量（仅词面匹配，用于测试与无密钥演示）；openai_compatible = 语义向量
RAG_EMBEDDING_PROVIDER=local
#
# --- 生产语义索引（百炼 text-embedding-v4，与 DASHSCOPE_API_KEY 共用）---
# 切换后需：python -m rag.cli reindex --all
# RAG_EMBEDDING_PROVIDER=openai_compatible
# RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_EMBEDDING_MODEL=text-embedding-v4
# RAG_EMBEDDING_DIM=1024
# RAG_EMBEDDING_BATCH_SIZE=10
# AI_PRICING_CONFIRMED=true
# RAG_EMBEDDING_CNY_PER_MILLION=0.7
# 语义检索推荐百炼 text-embedding-v4（与 ASR/TTS 共用 DASHSCOPE_API_KEY，也可单独设 RAG_EMBEDDING_API_KEY）
# 本机自建模型（如 Ollama/Xinference 部署 bge-m3）不计费：
# RAG_EMBEDDING_BASE_URL=http://127.0.0.1:9997/v1
# RAG_EMBEDDING_MODEL=bge-m3
# 更换模型或维度后执行：python -m rag.cli reindex
# numpy = 精确检索（默认，无新增依赖）；faiss 需 pip install faiss-cpu
# RAG_VECTOR_BACKEND=numpy
# RAG_TOP_K=5
# 低于该余弦相似度的片段不作为依据；默认 local=0.12，语义模型=0.40，按实际语料校准
# RAG_MIN_SCORE=
# RAG_CHUNK_TARGET_CHARS=500
# RAG_CHUNK_MAX_CHARS=900
# RAG_CHUNK_OVERLAP_CHARS=80
# RAG_MAX_UPLOAD_MB=20
# 混合检索 / 精排 / 问句改写（详见 docs/rag/architecture.md）
# RAG_HYBRID_ENABLED=true
# RAG_FETCH_K=20
# RAG_RRF_K=60
# RAG_RERANK_ENABLED=true
# RAG_QUERY_REWRITE=expand
# RAG_PARENT_CONTEXT=true
# RAG_GRAPH_META=true
# RAG_GRAPH_ENABLED=false
# RAG_GRAPH_MAX_DEPTH=2
# RAG_GRAPH_MAX_EXPANSIONS=32
# RAG_ASYNC_INGEST=true

# 使用 Docker 启动 MySQL：在项目根目录执行 docker compose up -d
# 使用本机 MySQL：先创建数据库 link，再执行 python init_db.py
