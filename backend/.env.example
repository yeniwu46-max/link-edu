DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/link?charset=utf8mb4
JWT_SECRET_KEY=link-demo-change-me
SEED_ON_STARTUP=true

# DeepSeek API（只在后端配置，不要提交真实密钥）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=60

# 使用 Docker 启动 MySQL：在项目根目录执行 docker compose up -d
# 使用本机 MySQL：先创建数据库 link，再执行 python init_db.py
