# Append to backend/.env. Never put keys in VITE_* variables.
DEEPSEEK_API_KEY=
# Optional purpose-specific keys: omit these variables to use DEEPSEEK_API_KEY.
# DEEPSEEK_DIALOGUE_API_KEY=
# DEEPSEEK_VISION_API_KEY=
# DEEPSEEK_TEST_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# Set to openai_next after configuring the three purpose-specific keys below.
CLASSROOM_LLM_PROVIDER=deepseek
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
OPENAI_NEXT_DIALOGUE_API_KEY=
OPENAI_NEXT_VISION_API_KEY=
OPENAI_NEXT_TEST_API_KEY=
OPENAI_NEXT_DIALOGUE_LIMIT_USD=30
OPENAI_NEXT_VISION_LIMIT_USD=40
OPENAI_NEXT_TEST_LIMIT_USD=30
OPENAI_NEXT_DIALOGUE_MODEL=deepseek-v4-flash
OPENAI_NEXT_VISION_MODEL=deepseek-v4-flash-vision-exp
# Peak / cache-miss USD estimates verified 2026-09-09; see docs/classroom-openai-next.md.
OPENAI_NEXT_DIALOGUE_INPUT_USD_PER_MILLION=0.44
OPENAI_NEXT_DIALOGUE_OUTPUT_USD_PER_MILLION=1.32
OPENAI_NEXT_VISION_INPUT_USD_PER_MILLION=0.44
OPENAI_NEXT_VISION_OUTPUT_USD_PER_MILLION=1.32
OPENAI_NEXT_PRICING_CONFIRMED=false
DASHSCOPE_API_KEY=
# Beijing region; key and endpoint must belong to the same region.
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
# Explicit provider choice. No automatic cross-provider fallback.
SPEECH_PROVIDER=xfyun
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
# Exact system voice identifier authorized in this app's console.
XFYUN_TTS_VOICE=xiaoyan
# Optional overrides; empty means sharing the default voice, not cloning.
XFYUN_TTS_VOICE_MING=
XFYUN_TTS_VOICE_YU=
XFYUN_TTS_VOICE_LIN=
# Per recognition segment / per synthesis request. Do not use Bailian prices.
# Positive conservative package-equivalent rates; free quota is not assumed unlimited.
XFYUN_ASR_CNY_PER_CALL=
XFYUN_TTS_CNY_PER_CALL=
XFYUN_PRICING_CONFIRMED=false
# Fill verified CNY prices from your console. LLM values must cover BOTH text
# and vision models, cache-miss peak input and maximum output prices.
AI_LLM_INPUT_CNY_PER_MILLION=
AI_LLM_OUTPUT_CNY_PER_MILLION=
AI_ASR_CNY_PER_MINUTE=
AI_TTS_CNY_PER_10K_CHARS=
AI_PRICING_CONFIRMED=false
