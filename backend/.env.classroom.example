# Append to backend/.env. Never put keys in VITE_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DASHSCOPE_API_KEY=
# Beijing region; key and endpoint must belong to the same region.
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-realtime
# Fill verified CNY prices from your console. LLM values must cover BOTH text
# and vision models, cache-miss peak input and maximum output prices.
AI_LLM_INPUT_CNY_PER_MILLION=
AI_LLM_OUTPUT_CNY_PER_MILLION=
AI_ASR_CNY_PER_MINUTE=
AI_TTS_CNY_PER_10K_CHARS=
AI_PRICING_CONFIRMED=false
