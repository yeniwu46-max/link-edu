PUBLIC_DEPLOYMENT=true
PUBLIC_ORIGINS=https://106.15.77.40:8443,https://www.lk.link-edu.cn
SEED_ON_STARTUP=false
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_40_RANDOM_CHARACTERS
DATABASE_URL=mysql+pymysql://link:REPLACE@db/link?charset=utf8mb4
CLASSROOM_MAX_ACTIVE=5
CLASSROOM_DAILY_LIMIT=2
DELIVERY_BUDGET_CNY=30
# Set ONCE before the first paid call. Preserve this timestamp and ledger on every upgrade.
DELIVERY_BUDGET_START=2026-09-14T00:00:00
USD_CNY_BUDGET_RATE=8
# Copy provider names, model IDs, verified prices and secrets from the private configuration.
AI_PRICING_CONFIRMED=false
CLASSROOM_LLM_PROVIDER=deepseek
SPEECH_PROVIDER=xfyun
DEEPSEEK_API_KEY=REPLACE
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# Recorded conservative billing rates; operator must reconfirm before enabling paid calls.
AI_LLM_INPUT_CNY_PER_MILLION=3
AI_LLM_OUTPUT_CNY_PER_MILLION=9
XFYUN_APP_ID=REPLACE
XFYUN_API_KEY=REPLACE
XFYUN_API_SECRET=REPLACE
XFYUN_PRICING_CONFIRMED=false
XFYUN_ASR_CNY_PER_CALL=0.0023
XFYUN_TTS_CNY_PER_CALL=0.0058
XFYUN_TTS_VOICE=xiaoyan
# RAG knowledge base stays off in public mode unless enabled; management requires listed accounts.
RAG_ENABLED=false
RAG_ADMIN_ACCOUNTS=
# 生产语义向量（启用 RAG 且入库/重建索引前核对控制台单价）
# RAG_ENABLED=true
# RAG_ADMIN_ACCOUNTS=your_admin_account
RAG_EMBEDDING_PROVIDER=local
